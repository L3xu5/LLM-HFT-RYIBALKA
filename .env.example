# --- Public, embedded into the mobile bundle ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# В новых проектах Supabase вместо legacy `anon` может использоваться Publishable key — его и подставляйте сюда.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...или_eyJhbGciOi...legacy_anon...
# Получить ключ: https://developer.tech.yandex.ru/, тип "JavaScript API и HTTP Геокодер"
# В кабинете ОБЯЗАТЕЛЬНО ограничьте referrer'ом / bundle id, т.к. ключ попадает в WebView.
EXPO_PUBLIC_YANDEX_MAPS_JS_API_KEY=00000000-0000-0000-0000-000000000000

# --- Server-only, ставится через `supabase secrets set` или `npm run llm:secrets` ---
# Вариант A: YANDEX_GPT_API_KEY + YANDEX_FOLDER_ID
# Вариант B: YANDEX_CLOUD_API_KEY + YANDEX_CLOUD_FOLDER (+ опционально YANDEX_CLOUD_MODEL)
# YANDEX_CLOUD_MODEL=yandexgpt-5.1/latest
# YANDEX_MODEL_URI=gpt://b1g.../yandexgpt-5.1/latest

# --- Опционально: выгрузка web в Yandex Object Storage (локально или CI — см. README) ---
# YANDEX_STORAGE_BUCKET=имя-бакета
# YANDEX_STORAGE_ACCESS_KEY_ID=YCA...
# YANDEX_STORAGE_SECRET_ACCESS_KEY=YCM...
