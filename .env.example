# --- Public, embedded into the mobile bundle ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# In newer Supabase projects, a Publishable key may be used instead of legacy `anon` - put it here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...or_eyJhbGciOi...legacy_anon...
# Get your key: https://developer.tech.yandex.ru/, type "JavaScript API and HTTP Geocoder"
# In the console, you MUST restrict it by referrer / bundle id because the key is embedded in WebView.
EXPO_PUBLIC_YANDEX_MAPS_JS_API_KEY=00000000-0000-0000-0000-000000000000

# --- Server-only, set via `supabase secrets set` or `npm run llm:secrets` ---
# Option A: YANDEX_GPT_API_KEY + YANDEX_FOLDER_ID
# Option B: YANDEX_CLOUD_API_KEY + YANDEX_CLOUD_FOLDER (+ optional YANDEX_CLOUD_MODEL)
# YANDEX_CLOUD_MODEL=yandexgpt-5.1/latest
# YANDEX_MODEL_URI=gpt://b1g.../yandexgpt-5.1/latest

# --- Optional: upload web build to Yandex Object Storage (local or CI - see README) ---
# YANDEX_STORAGE_BUCKET=bucket-name
# YANDEX_STORAGE_ACCESS_KEY_ID=YCA...
# YANDEX_STORAGE_SECRET_ACCESS_KEY=YCM...
